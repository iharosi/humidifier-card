{
  "name": "humidifier-card",
  "version": "0.2.0",
  "description": "Lovelace card to display and control an ESPHome-exposed Xiaomi Smart Humidifier 2",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "lint": "eslint src test && prettier --check src test",
    "format": "prettier --write src test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "eslint": "^10.10.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.3.3",
    "rollup": "^4.63.3",
    "tslib": "^2.8.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iharosi/humidifier-card.git"
  },
  "bugs": {
    "url": "https://github.com/iharosi/humidifier-card/issues"
  },
  "homepage": "https://github.com/iharosi/humidifier-card#readme",
  "author": "vision <vision.app.inc@gmail.com>",
  "engines": {
    "node": ">=22.22.2"
  }
}
